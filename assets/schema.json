{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "name": "odas-app-bussgelder-geschwindigkeitsverstoesse",
  "title": "Bußgelder Geschwindigkeitsverstöße",
  "fields": [
    {
      "name": "TATTAG",
      "title": "Tattag",
      "type": "date",
      "format": "%d.%m.%Y",
      "description": "Tag des Verstoßes im Format TT.MM.JJJJ.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "TATZEIT",
      "title": "Tatzeit",
      "type": "string",
      "description": "Uhrzeit des Verstoßes als vierstellige Zahl HHMM (mit führender Null).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "TATORT",
      "title": "Tatort",
      "type": "string",
      "description": "Messstelle bzw. Ortsangabe des Verstoßes.",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "TATBESTANDBE_TBNR",
      "title": "Tatbestandsnummer",
      "type": "string",
      "description": "Tatbestandsnummer des Verstoßes (Schlüssel, keine Rechengröße).",
      "constraints": {
        "required": false
      }
    },
    {
      "name": "GELDBUSSE",
      "title": "Geldbuße (€)",
      "type": "number",
      "decimalChar": ",",
      "description": "Verwarnungs-/Bußgeld in Euro, mit Dezimalkomma (z. B. 132,5).",
      "constraints": {
        "required": false
      }
    }
  ]
}
